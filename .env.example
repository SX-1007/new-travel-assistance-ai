# Travel Assistant AI backend: every setting it reads.
# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Settings are read by app/infrastructure/config/settings.py; the process
# environment wins over this file.

# ── Deployment ────────────────────────────────────────────────────────
# development (default) or production. Production turns off /docs, allows
# only CORS_ORIGINS, sends HSTS, and refuses to start with
# AUTH_INSECURE_DEV_TOKENS or without the Upstash settings.
ENVIRONMENT=development
# Comma-separated frontend origins. Required in production (https:// only).
# Development also allows any localhost port.
CORS_ORIGINS=
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# ── Gemini (required: GEMINI_API_KEY) ─────────────────────────────────
GEMINI_API_KEY=
# Backup key, same model, used when a task's own key fails.
GEMINI_API_KEY_2=
# Optional per-task keys; each falls back to GEMINI_API_KEY.
GEMINI_IATA_API=
GEMINI_FLIGHTS_HOTELS=
GEMINI_EXTRACTOR_API=
GEMINI_DESTINATION_API=
GEMINI_ACTIVITIES_API=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_UTILITY_MODEL=gemini-3.1-flash-lite
# Calls per minute per key and model (free tier: 15). 0 turns pacing off.
GEMINI_REQUESTS_PER_MINUTE=15

# ── OpenRouter (optional last-resort backup model) ────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_REQUESTS_PER_MINUTE=20

# ── PostgreSQL (required) ─────────────────────────────────────────────
# A DIRECT connection string (not a transaction pooler): the app pools its
# own connections and sets a per-connection statement timeout.
DATABASE_URL=

# ── Firebase sign-in (required) ───────────────────────────────────────
# Path to the service-account JSON file, or the raw JSON.
FIREBASE_CREDENTIAL_JSON=
# Development only: true accepts "Bearer <user id>" with no check.
AUTH_INSECURE_DEV_TOKENS=false

# ── Upstash Redis (cache and request limits; required in production) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Providers (required unless marked optional) ───────────────────────
MAPBOX_TOKEN=
SERPAPI_FLIGHT=
SERPAPI_HOTEL=
SERPAPI_PLACE=
# Optional: factual web search key (falls back to SERPAPI_PLACE).
SERPAPI_FACTUAL=
# Optional: Exa is tried first for factual questions when set.
EXA_API_KEY=
FREECURRENCY_API=

# ── Tests only ────────────────────────────────────────────────────────
# A throwaway PostgreSQL (a Neon test branch or a local server) for the
# database tests; never the live database. Unset: those tests are skipped.
# TEST_DATABASE_URL=
