# Base URL of the FastAPI backend (../app, started with `python run.py`). No trailing slash.
VITE_API_BASE_URL=http://localhost:8000

# Google sign-in (Firebase Authentication). Copy these from the Firebase
# console: Project settings → General → Your apps → Web app → SDK setup and
# configuration. They are the public web config, not secrets. The project must
# be the one in the backend's FIREBASE_CREDENTIAL_JSON, or every token is refused.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# (Optional) Public Mapbox access token — enables the per-day static route map
# in the itinerary view. Get one at https://account.mapbox.com/access-tokens/.
# If unset, the itinerary still shows the route stops + distances as text.
VITE_MAPBOX_TOKEN=
